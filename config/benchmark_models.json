{
  "study": "cnn-xgboost-tcn",
  "dataset_dir": "dataset/benchmark",
  "dataset_id": "69395a7f7f7d66a9066687445aca249e9d67a994a12b1466920fb4e64102b465",
  "models": ["cnn_bilstm", "xgboost", "tcn"],
  "seeds": [42, 73, 101],
  "cpu_threads": 6,
  "target_recall": 0.9,
  "target_fpr": 0.1,
  "bootstrap_repetitions": 1000,
  "bootstrap_seed": 42,
  "selection": "minimum_unweighted_validation_log_loss_then_seed",
  "threshold_fit_split": "calibration",
  "test_role": "previously_observed_exploratory_test",
  "production_activation": false,
  "cnn_bilstm": {
    "manifest": "models/active_model.json",
    "strategy": "reuse_existing_tensorflow_checkpoint_selected_on_validation",
    "selected_seed": 73
  },
  "tfidf": {
    "ngram_range": [1, 2],
    "max_features": 20000,
    "min_df": 2,
    "sublinear_tf": true,
    "fit_split": "train",
    "input": "all_normalized_lexical_tokens"
  },
  "xgboost": {
    "n_estimators": 600,
    "max_depth": 6,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 2,
    "reg_lambda": 1,
    "tree_method": "hist",
    "objective": "binary:logistic",
    "eval_metric": "logloss",
    "early_stopping_rounds": 40
  },
  "tcn": {
    "strategy": "from_scratch_causal_dilated_residual_convolutions",
    "input": "all_losslessly_encoded_normalized_lexical_tokens",
    "embedding_dim": 32,
    "channels": 24,
    "kernel_size": 3,
    "dilations": [1, 2, 4, 8, 16, 32, 64, 128, 256],
    "convolutions_per_block": 2,
    "pooling": "masked_mean_and_max_over_all_encoded_tokens",
    "dense_units": 32,
    "batch_size": 32,
    "batch_token_budget": 16384,
    "loss_unit": "contract",
    "epochs": 12,
    "early_stopping_patience": 3,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "dropout": 0.2,
    "cpu_threads": 6,
    "checkpoint_every_batches": 100
  }
}
